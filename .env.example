# Copy this file to .env and adjust values for your environment
#   cp .env.example .env

# --- Database ---------------------------------------------------------
# PostgreSQL connection string. Format:
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://bugpilot_user:bugpilot_pass@localhost:5432/bugpilot_db

# Only use this if you ever want to go back to local SQLite for a quick
# throwaway test. Not recommended once you're on Postgres.
# DATABASE_URL=sqlite:///./dev_test.db

# --- Auth / JWT ---------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Google Gemini (https://aistudio.google.com/app/apikey) ----------------
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# --- AI Bug Generator upload limits -----------------------------------------
MAX_IMAGE_SIZE_MB=8
MAX_TEXT_FIELD_CHARS=20000
ALLOWED_IMAGE_CONTENT_TYPES=image/png,image/jpeg,image/jpg,image/webp
